        DISCO1 = "${params.DISCO}"
        SECURITYGROUP1 = "${params.SECURITYGROUP}"
        KEYPAIR1 = "${params.KEYPAIR}"
        AWS_IAM_ROLE = 'Name=iam-role'
        TAGBKP1 = "${params.TAGBKP}"
        SERVICEBACKUP1 = "${params.SERVICEBACKUP}"
      }
      steps {
        script {
          def TAG_CC_ID = sh(
