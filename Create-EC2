          if (params.USERDATA?.trim()) {
            writeFile file: 'userdata.sh', text: params.USERDATA
            USERDATA64 = sh(script: 'base64 userdata.sh | tr -d "\\n"', returnStdout: true).trim()
            USERDATA_OPTION = "--user-data '${USERDATA64}'"
          }

          def BLOCK_DEVICE_OPTION = ''
          if (params.DISCO && params.DISCO != 'default') {
            BLOCK_DEVICE_OPTION = "--block-device-mappings '[{\"DeviceName\":\"/dev/xvda\",\"Ebs\":{\"VolumeSize\":${params.DISCO},\"VolumeType\":\"gp3\",\"DeleteOnTermination\":true}}]'"
          }

          dir("${BUILD_NUMBER}/PRD") {
            sh """
              set -ex

              aws ec2 run-instances --profile ${AWS_PROFILE} \\
                --region ${REGION1} \\
                --image-id ${AMI1} \\
                --instance-type ${INSTANCETYPE1} \\
                --count ${COUNT1} \\
                --subnet-id \$(echo "${SUBNET1}" | sed 's/ -.*\$//') \\
                --security-group-ids \$(echo "${SECURITYGROUP1}" | sed 's/ -.*\$//') \\
                --iam-instance-profile ${AWS_IAM_ROLE} \\
                --key-name \$(echo "${KEYPAIR1}" | sed 's/ -.*\$//') \\
                --disable-api-termination \\
                --metadata-options HttpTokens=required,HttpEndpoint=enabled \\
                ${BLOCK_DEVICE_OPTION} \\
                ${USERDATA_OPTION} \\
                --tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=${NAME1}},{Key=${SERVICEBACKUP1},Value=${TAGBKP1}},{Key=Region,Value=${REGION1}},{Key=ENV,Value=${TAGENV}},{Key=CC,Value=${TAG_CC_ID}},{Key=Vertical,Value=${TAGVERTICAL}},{Key=Servico,Value=${TAGSERVICO}},{Key=Contexto,Value=${TAGCONTEXTO}}]"

              exit 0
            """
          }
        }
      }
    }

    /******************
     ** AMBIENTE Extra **
     ******************/
