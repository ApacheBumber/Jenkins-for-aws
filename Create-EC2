                --iam-instance-profile ${AWS_IAM_ROLE} \\
                --key-name \$(echo "${KEYPAIR1}" | sed 's/ -.*\$//') \\
                --disable-api-termination \\
                --metadata-options HttpTokens=required,HttpEndpoint=enabled \\
                ${BLOCK_DEVICE_OPTION} \\
                ${USERDATA_OPTION} \\
                --tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=${NAME1}},{Key=${SERVICEBACKUP1},Value=${TAGBKP1}},{Key=Region,Value=${REGION1}},{Key=ENV,Value=${TAGENV}},{Key=CC,Value=${TAG_CC_ID}},{Key=Vertical,Value=${TAGVERTICAL}},{Key=Servico,Value=${TAGSERVICO}},{Key=Contexto,Value=${TAGCONTEXTO}}]"

              exit 0
            """
          }
        }
      }
    }

    /******************
     ** AMBIENTE PRD **
     ******************/
    stage('Confirmação PRD') {
      when {
        expression { params.ACCOUNT in ['PRD'] }
      }
      steps {
        script {
          timeout(time: 3, unit: 'DAYS') {
            input(
              message: """⚠️ *Atenção!*
Esta ação só pode ser executada pelo *time de *.
Caso você não pertença a esse grupo, por favor *Entra em contato com o time de  para validação*.

Deseja realizar o deployment em *Produção (PRD)*?""",
              submitter: 'admin',
              ok: 'Confirmar Deployment'
            )
          }
        }
      }
    }

    stage('Git Checkout') {
      steps {
        script {
          sh "git log -1 --pretty=oneline"

          dir("${BUILD_NUMBER}/checkout") {
            git branch: env.BRANCH_NAME, credentialsId: env.GIT_CREDENTIALSID, url: env.GIT_REPO
          }
        }
      }
    }

    stage('PRD: Criando Instância EC2') {
      when {
        expression { params.ACCOUNT == 'PRD' }
      }
      environment {
        AWS_PROFILE = 'prd'
        ENVIRONMENT = 'prd'
        NAME1 = "${params.NOME}"
